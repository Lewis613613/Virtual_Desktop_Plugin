<Window x:Class="VirtualDesktopPanel.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Virtual Desktop Panel Settings"
        Width="400" Height="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Click Behavior -->
        <GroupBox Grid.Row="0" Header="Click Behavior" Margin="0,0,0,8">
            <StackPanel Margin="4">
                <RadioButton x:Name="RbKeepOpen" Content="Keep panel open" Margin="0,2"/>
                <RadioButton x:Name="RbAutoClose" Content="Auto-close panel" Margin="0,2"/>
            </StackPanel>
        </GroupBox>

        <!-- Panel Size -->
        <GroupBox Grid.Row="1" Header="Panel Size" Margin="0,0,0,8">
            <Grid Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Width" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox x:Name="TxtPanelWidth" Grid.Column="1" Width="50"/>
                <TextBlock Text="%" Grid.Column="2" VerticalAlignment="Center" Margin="4,0,8,0"/>
                <TextBlock Text="Height" Grid.Column="3" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox x:Name="TxtPanelHeight" Grid.Column="4" Width="50"/>
            </Grid>
        </GroupBox>

        <!-- Grid Size -->
        <GroupBox Grid.Row="2" Header="Grid Cell Size" Margin="0,0,0,8">
            <Grid Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Width (px)" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox x:Name="TxtCellWidth" Grid.Column="1" Width="50"/>
                <TextBlock Text="Height (px)" Grid.Column="2" VerticalAlignment="Center" Margin="8,0,4,0"/>
                <TextBox x:Name="TxtCellHeight" Grid.Column="3" Width="50"/>
            </Grid>
        </GroupBox>

        <!-- Theme Preset -->
        <GroupBox Grid.Row="3" Header="Theme Preset" Margin="0,0,0,8">
            <ComboBox x:Name="CmbTheme" Margin="4" SelectedIndex="0">
                <ComboBoxItem Content="Dark"/>
                <ComboBoxItem Content="Black"/>
                <ComboBoxItem Content="Light"/>
                <ComboBoxItem Content="System (Mica)"/>
                <ComboBoxItem Content="Custom"/>
            </ComboBox>
        </GroupBox>

        <!-- Background Color -->
        <GroupBox Grid.Row="4" Header="Background" Margin="0,0,0,8">
            <Grid Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtBgColor" Width="80"/>
                <TextBlock Text="Opacity" Grid.Column="2" VerticalAlignment="Center" Margin="8,0,4,0"/>
                <Slider x:Name="SldOpacity" Grid.Column="3" Minimum="0.1" Maximum="1.0"
                        TickFrequency="0.05" IsSnapToTickEnabled="True" Value="0.85"/>
            </Grid>
        </GroupBox>

        <!-- Blur Effect -->
        <GroupBox Grid.Row="5" Header="Blur Effect" Margin="0,0,0,8">
            <ComboBox x:Name="CmbBlur" Margin="4" SelectedIndex="0">
                <ComboBoxItem Content="Acrylic"/>
                <ComboBoxItem Content="Mica"/>
                <ComboBoxItem Content="None"/>
            </ComboBox>
        </GroupBox>

        <!-- Auto Start -->
        <GroupBox Grid.Row="6" Header="Startup" Margin="0,0,0,8">
            <CheckBox x:Name="ChkAutoStart" Content="Start with Windows" Margin="4"/>
        </GroupBox>

        <!-- Buttons -->
        <StackPanel Grid.Row="9" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Save" Width="80" Height="30" Click="OnSaveClick"
                    Background="#4a9eff" Foreground="White" BorderThickness="0"/>
            <Button Content="Cancel" Width="80" Height="30" Margin="8,0,0,0" Click="OnCancelClick"/>
        </StackPanel>
    </Grid>
</Window>
